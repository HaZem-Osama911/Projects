@model MegaSoft.Models.TaskItems

@{
    ViewData["Title"] = "Task Details";
}

<div class="container py-4 task-details-page details-page">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="mb-3">
                <a asp-action="Task_Dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                </a>
            </div>

            <div class="card shadow-lg border-0 mb-4 animate-fadeIn">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Task Details
                    </h4>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="detail-item">
                                <label class="detail-label">
                                    <i class="bi bi-card-checklist me-2 text-primary"></i>Title
                                </label>
                                <div class="detail-value">@Model.Title</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-item">
                                <label class="detail-label">
                                    <i class="bi bi-people me-2 text-info"></i>Team
                                </label>
                                <div class="detail-value">
                                    <span class="badge bg-secondary text-white rounded-pill px-3 py-2">@Model.Team?.Name</span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="col-12">
                                <div class="detail-item detail-item--info">
                                    <label class="detail-label">
                                        <i class="bi bi-card-text me-2 text-info"></i>Description
                                    </label>
                                    <div class="detail-value">@Model.Description</div>
                                </div>
                            </div>
                        }

                        <div class="col-md-4">
                            <div class="detail-item detail-item--warning">
                                <label class="detail-label">
                                    <i class="bi bi-flag me-2 text-warning"></i>Status
                                </label>
                                <div class="detail-value">
                                    <span class="badge @(Model.Status?.ToString() == "ToDo" ? "bg-warning text-dark" :
                                                       Model.Status?.ToString() == "InProgress" ? "bg-primary text-white" :
                                                       "bg-success text-white") rounded-pill px-3 py-2">
                                        @Model.Status
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-item detail-item--primary">
                                <label class="detail-label">
                                    <i class="bi bi-lightning-charge me-2 text-primary"></i>Priority
                                </label>
                                <div class="detail-value">
                                    <span class="badge @(Model.Priority?.ToString() == "High" ? "bg-danger text-white" :
                                                       Model.Priority?.ToString() == "Medium" ? "bg-info text-dark" :
                                                       "bg-secondary text-white") rounded-pill px-3 py-2">
                                        @Model.Priority
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-item detail-item--success">
                                <label class="detail-label">
                                    <i class="bi bi-calendar-event me-2 text-success"></i>Deadline
                                </label>
                                <div class="detail-value">
                                    @(Model.Deadline.HasValue ? Model.Deadline.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit_Task" asp-route-id="@Model.Id" class="btn btn-modern btn-warning">
                    <i class="bi bi-pencil-square me-1"></i>Edit Task
                </a>
                <a asp-action="Delete_Task" asp-route-id="@Model.Id" class="btn btn-modern btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Delete Task
                </a>
            </div>
        </div>
    </div>
</div>
